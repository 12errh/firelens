# FastAPI evidence mirror — optional deployment target (Render/Fly/Railway)
#
# DATA_DIR defaults to ../web/data relative to api/main.py.
# ALLOWED_ORIGINS is a comma-separated list. Vercel preview domains are allowed
# automatically by regex.
DATA_DIR=
ALLOWED_ORIGINS=http://localhost:3000

# Optional document-RAG proxy for POST /api/chat
RAG_API_URL=
RAG_API_KEY=
